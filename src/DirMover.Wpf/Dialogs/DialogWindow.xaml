<Window x:Class="DirMover.Wpf.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DirMover"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">

    <!--
      为什么自绘窗口而不是 MessageBox：MessageBox 的字体/行高/段间距/按钮顺序全部不可控，
      中文长正文会挤成一块；而本工具 14 类弹窗的正文里有路径、失败清单、等宽报告，
      排版是"能不能读"的问题，不是观感问题。
      自绘后与主窗口共用同一套 Tokens（底色/描边/圆角/强调按钮），视觉上是一个产品。
    -->
    <Border
        x:Name="Shell"
        Margin="16"
        Padding="24,20,24,18"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource CardStrokeBrush}"
        BorderThickness="{StaticResource CardBorderThickness}"
        CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Direction="270"
                Opacity="0.18"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock
                x:Name="TitleText"
                Grid.Row="0"
                Margin="0,0,0,14"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                TextWrapping="Wrap" />

            <!-- 正文：超高时内部滚动，弹窗本身不会超出屏幕 -->
            <ScrollViewer
                x:Name="BodyScroll"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="BodyHost" />
            </ScrollViewer>

            <!-- 按钮条：右对齐；主按钮在最右（与 WinUI ContentDialog 的阅读顺序一致） -->
            <StackPanel
                x:Name="ButtonBar"
                Grid.Row="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal" />
        </Grid>
    </Border>
</Window>
