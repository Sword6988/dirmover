<Window x:Class="DirMover.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DirMover.App.ViewModels"
        Title="DirMover"
        Width="{StaticResource DefaultWidth}"
        Height="{StaticResource DefaultHeight}"
        MinWidth="{StaticResource MinWindowWidth}"
        MinHeight="{StaticResource MinWindowHeight}"
        Background="{StaticResource PageBackgroundBrush}"
        Closing="OnWindowClosing"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!--
      MainWindow.xaml（WPF 版）—— 与 WinUI 版布局逐块对应：7 行网格，
      行 2 / 行 5 是 1 像素分隔线，只有表格行是 *。

      两处框架差异（不影响视觉）：
        * WinUI 的 InfoBar 在 WPF 没有对应控件，提权提示条用"淡黄底 Border + 文案 + 链接按钮"手搭；
        * WinUI 的 KeyboardAccelerator 换成 <Window.InputBindings>。
    -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding PrimaryCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root" Background="{StaticResource PageBackgroundBrush}" Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ 行0：提权提示条 -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,12"
            Padding="12,8"
            Background="{StaticResource WarningSubtleBrush}"
            CornerRadius="6"
            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{StaticResource WarningTextBrush}"
                    Text="{Binding ElevationBody}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding RelaunchAsAdminCommand}"
                    Content="{Binding RelaunchAsAdminText}"
                    Style="{StaticResource LinkButtonStyle}"
                    Visibility="{Binding IsDryRun, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ============================================================ 行1：目标根目录 + 空间 -->
        <Grid Grid.Row="1" Margin="{StaticResource SectionGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Style="{StaticResource TableHeaderTextStyle}"
                Text="{Binding DestinationLabel}" />

            <ComboBox
                Grid.Column="1"
                MinWidth="{StaticResource DestinationComboMinWidth}"
                HorizontalAlignment="Left"
                DisplayMemberPath="TargetRoot"
                IsEnabled="{Binding IsInputEnabled}"
                ItemsSource="{Binding Drives}"
                SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                Style="{StaticResource AppComboBoxStyle}" />

            <TextBlock
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource StatusTextStyle}"
                Text="{Binding SpaceLabel}" />
        </Grid>

        <!-- ============================================================ 行2：分隔线 -->
        <Border Grid.Row="2" Margin="{StaticResource DividerGap}" Background="{StaticResource DividerBrush}" />

        <!-- ============================================================ 行3：表格（卡片表面） -->
        <Border
            Grid.Row="3"
            Margin="{StaticResource TableCardGap}"
            Padding="{StaticResource TableCardPadding}"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource CardStrokeBrush}"
            BorderThickness="{StaticResource CardBorderThickness}"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头：与行模板共用同一份 Columns.*Width，列宽才可能对齐 -->
                <Grid Grid.Row="0" Height="{StaticResource HeaderRowHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="{Binding Columns.NameWidth}" />
                        <ColumnDefinition Width="{Binding Columns.CurrentWidth}" />
                        <ColumnDefinition Width="{Binding Columns.TargetWidth}" />
                        <ColumnDefinition Width="{Binding Columns.StatusWidth}" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnNameHeader}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnCurrentHeader}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnTargetHeader}" />
                    <TextBlock
                        Grid.Column="4"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnStatusHeader}" />
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource HeaderLineBrush}" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox
                        x:Name="FolderList"
                        Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        ItemContainerStyle="{StaticResource FolderRowItemStyle}"
                        ItemsSource="{Binding Rows}"
                        KeyDown="OnFolderListKeyDown"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single"
                        SizeChanged="OnFolderListSizeChanged">
                        <!--
                          滚动条不需要在这里显式引用样式：Theme/Styles.xaml 里给 ScrollBar 设了
                          隐式样式（纵向/横向两套模板 + 8→12px 悬停展开），列表、下拉浮层、
                          弹窗正文、等宽报告区共用同一份。
                        -->
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                                <!--
                                  三层结构（自下而上）：状态底色 → 悬停遮罩 → 内容。
                                  悬停遮罩必须压在底色之上、内容之下，且不吃指针事件。
                                -->
                                <Grid>
                                    <Border
                                        Background="{Binding RowState, Converter={StaticResource RowStateToBackground}}"
                                        Opacity="{Binding RowState, Converter={StaticResource RowStateToOpacity}}" />

                                    <Border
                                        x:Name="RowHoverLayer"
                                        Background="{StaticResource RowHoverBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <Grid Height="{StaticResource RowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="{Binding Columns.NameWidth}" />
                                            <ColumnDefinition Width="{Binding Columns.CurrentWidth}" />
                                            <ColumnDefinition Width="{Binding Columns.TargetWidth}" />
                                            <ColumnDefinition Width="{Binding Columns.StatusWidth}" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            Grid.Column="0"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            IsEnabled="{Binding CanSelect}"
                                            Style="{StaticResource RowCheckBoxStyle}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToForeground}}"
                                            Style="{StaticResource TableNameCellTextStyle}"
                                            Text="{Binding Display}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToForeground}}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding Current}"
                                            TextTrimming="CharacterEllipsis" />

                                        <!--
                                          目标列双分支：真要搬时显示目标路径；与当前位置相同时只显示一句弱化占位，
                                          避免同一串路径在相邻两列重复出现。占位为 14px + 淡灰（与其他列同字号，
                                          只靠颜色表达"这是注释"）。
                                        -->
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToForeground}}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding Target}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsSameAsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding SameTargetText}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsSameAsCurrent, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- 状态列：只有文字，按状态着色，不裁字（裁字会藏掉失败原因） -->
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToStatusForeground}}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding Status}"
                                            TextTrimming="None" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="RowHoverLayer" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态：7 项全部"路径相同"时填充下方空白 -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="{StaticResource EmptyStateGap}"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <Border
                            Width="{StaticResource EmptyStateBadgeSize}"
                            Height="{StaticResource EmptyStateBadgeSize}"
                            HorizontalAlignment="Center"
                            Background="{StaticResource EmptyStateBadgeBrush}"
                            CornerRadius="{StaticResource EmptyStateBadgeCornerRadius}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="{StaticResource EmptyStateIconSize}"
                                Foreground="{StaticResource EmptyStateCheckBrush}"
                                Text="&#xE73E;" />
                        </Border>
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeStrong}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{Binding EmptyStateTitle}" />
                        <TextBlock
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding EmptyStateSubtitle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================ 行4：操作条 -->
        <Grid Grid.Row="4" Margin="{StaticResource SectionGap}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 子行0：选项（全选摘要 / 创建用户目录） -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    Grid.Column="0"
                    Content="{Binding SelectAllText}"
                    IsChecked="{Binding AllSelected, Mode=TwoWay}"
                    IsEnabled="{Binding CanToggleSelectAll}"
                    Style="{StaticResource AppCheckBoxStyle}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding SelectionSummary}"
                    ToolTip="{Binding SelectionSummary}" />

                <CheckBox
                    Grid.Column="2"
                    Content="{Binding CreateUserDirectoryText}"
                    IsChecked="{Binding CreateUserDirectory, Mode=TwoWay}"
                    IsEnabled="{Binding IsInputEnabled}"
                    Style="{StaticResource AppCheckBoxStyle}" />
            </Grid>

            <!-- 子行1：命令（退出｜撑开｜恢复默认｜主操作） -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Command="{Binding ExitCommand}"
                    Content="{Binding ExitText}"
                    Style="{StaticResource DefaultButtonStyle}"
                    ToolTip="{Binding ExitText}" />

                <Button
                    Grid.Column="2"
                    Margin="{StaticResource DangerGap}"
                    Command="{Binding RestoreDefaultsCommand}"
                    Content="{Binding RestoreDefaultsText}"
                    Style="{StaticResource DangerButtonStyle}"
                    ToolTip="{Binding RestoreDefaultsText}" />

                <Button
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    Command="{Binding PrimaryCommand}"
                    Content="{Binding PrimaryButtonText}"
                    IsDefault="False"
                    IsEnabled="{Binding IsPrimaryEnabled}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    ToolTip="{Binding PrimaryButtonText}" />
            </Grid>
        </Grid>

        <!-- ============================================================ 行5：分隔线 -->
        <Border Grid.Row="5" Margin="{StaticResource DividerGap}" Background="{StaticResource DividerBrush}" />

        <!-- ============================================================ 行6：状态栏 -->
        <Grid Grid.Row="6" Margin="{StaticResource StackGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Style="{StaticResource StatusTextStyle}"
                Text="{Binding StatusText}"
                ToolTip="{Binding StatusText}" />

            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding OpenLogCommand}"
                Content="{Binding OpenLogText}"
                Style="{StaticResource LinkButtonStyle}"
                ToolTip="{Binding OpenLogText}"
                Visibility="{Binding IsLogLinkVisible, Converter={StaticResource BoolToVisibility}}" />

            <ProgressBar
                Grid.Column="2"
                Width="{StaticResource ProgressWidth}"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Maximum="100"
                Minimum="0"
                Style="{StaticResource ThinProgressBarStyle}"
                Value="{Binding ProgressValue, Mode=OneWay}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Border
                Grid.Column="3"
                Margin="12,0,0,0"
                Padding="8,2"
                Background="{StaticResource WarningSubtleBrush}"
                CornerRadius="10"
                Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource WarningTextBrush}"
                    Text="{Binding DryRunBadge}" />
            </Border>
        </Grid>
    </Grid>
</Window>
