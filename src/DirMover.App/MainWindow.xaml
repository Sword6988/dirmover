<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml —— 单屏零导航的唯一页面（架构 §7.1）。

  7 行固定网格：行高 Auto / Auto / 1 / * / Auto / 1 / Auto。
  行2、行5 是 1 像素分隔线，不参与伸缩；只有行3（表格）是 *。

  两条硬约束（违反后表现是"界面没数据"或"点了没反应"，都不报错）：
    * 根 Grid 必须 x:Name="Root"，且 code-behind 里显式 Root.DataContext = vm。
      WinUI 的 DataContext 不沿 Window 继承，缺了就是整页绑定静默失败。
    * 行模板只用 {Binding}，不写 ElementName= / RelativeSource=（模板 DataContext 由
      ItemsSource 逐项提供，另指源头会让行内某些列永远拿不到值）。

  视觉分层（两级"表面"）：
    * 页面层：根 Grid 背景取 PageBackgroundBrush（浅灰蓝），整屏不再是一张纯白平铺；
    * 表面层：表格区包一层 SurfaceBrush 卡片（1px CardStrokeBrush 细边 + 8 圆角），
      表格卡片因此"浮"在页面上——层次靠底色差与描边表达，不引入阴影（浅色小卡片上阴影发脏）。

  本文件不出现中文字面量：所有可见文案来自 MainViewModel 里转出的 UiText 常量。
-->
<Window
    x:Class="DirMover.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DirMover.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
      转换器定义在 App.xaml 的应用级资源里，不在这里：
      行模板是 DataTemplate，模板内的 {StaticResource} 只在「模板自身资源 → Application.Resources」
      这条链上解析，不会向上走页面可视树。放页面级会编译通过、运行到第一行就 XamlParseException。
    -->
    <!--
      RequestedTheme 锁定浅色：界面配色按浅色调校（Tokens.xaml 的深色档只是主题切换时的安全网），
      不跟随系统主题——Windows 切到深色时程序保持原样，避免出现"没调过的深色界面"。
    -->
    <!--
      Background 取 PageBackgroundBrush（页面层底色）。
      它在根 Grid 上而不是 Window 上：Window 没有 Background 可设，且根 Grid 已经铺满客户区，
      Padding 之外的颜色同样由它填充，四边不会露出默认白/黑底。
    -->
    <Grid
        x:Name="Root"
        Padding="{StaticResource PagePadding}"
        Background="{ThemeResource PageBackgroundBrush}"
        RequestedTheme="Light">

        <Grid.KeyboardAccelerators>
            <!-- Ctrl+Enter 触发主操作；它不切换勾选（切换归 ListView.KeyDown 管）。 -->
            <KeyboardAccelerator
                Key="Enter"
                Modifiers="Control"
                Invoked="OnPrimaryAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!--
              勾选框勾色重定向（根级主题键覆盖，覆盖本页全部 9 个 CheckBox：
              7 个行勾选 + 全选 + 创建当前用户目录）。
              为什么在这里：WinUI 的 CheckBox 模板勾选态消费
              CheckBoxCheckBackgroundFillChecked 系列"主题画刷键"，其默认值被
              XamlControlsResources 固定在 OS 强调色上，App 级覆盖不可达（实测）；
              但模板态的 {ThemeResource} 查找会沿可视树向上走，根级同名覆盖即生效
              （与危险按钮实例级覆盖同一查找机制，零模板自绘）。
              四态取 Tokens 的强调四档：正常 / 悬停(Secondary) / 按下(Tertiary) / 禁用(Disabled)。
              勾号前景不覆盖：默认 TextOnAccent 系为白色，压在青碧底上本就成立。
            -->
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ 行0：提权提示条 -->
        <InfoBar
            x:Name="AdminBanner"
            Grid.Row="0"
            IsClosable="False"
            IsOpen="{Binding IsElevated, Converter={StaticResource InverseBool}}"
            Message="{Binding ElevationBody}"
            Severity="Warning">
            <InfoBar.Content>
                <HyperlinkButton
                    Command="{Binding RelaunchAsAdminCommand}"
                    Content="{Binding RelaunchAsAdminText}"
                    Style="{StaticResource LinkButtonStyle}"
                    Visibility="{Binding IsDryRun, Converter={StaticResource InverseBoolToVisibility}}" />
            </InfoBar.Content>
        </InfoBar>

        <!-- ============================================================ 行1：目标根目录 + 空间 -->
        <!--
          Margin 用 SectionGap：根目录行整体左缩进，与表格/操作条形成半档错位层次。
          这一行刻意<b>不</b>套卡片：页面里只留"表格"一张卡片，卡片数量一多就退化成碎片，
          本行与表格之间靠分隔线 + 卡片自身的描边分层即可。
        -->
        <Grid Grid.Row="1" Margin="{StaticResource SectionGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Style="{StaticResource TableHeaderTextStyle}"
                Text="{Binding DestinationLabel}" />

            <!-- MinWidth 取 DestinationComboMinWidth：窄窗口下也要一眼看清完整目标根路径 -->
            <ComboBox
                Grid.Column="1"
                MinWidth="{StaticResource DestinationComboMinWidth}"
                DisplayMemberPath="TargetRoot"
                IsEditable="False"
                IsEnabled="{Binding IsInputEnabled}"
                ItemsSource="{Binding Drives}"
                SelectedItem="{Binding SelectedDrive, Mode=TwoWay}" />

            <TextBlock
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource StatusTextStyle}"
                Text="{Binding SpaceLabel}" />
        </Grid>

        <!-- ============================================================ 行2：分隔线 -->
        <Border
            Grid.Row="2"
            Margin="{StaticResource DividerGap}"
            Background="{ThemeResource DividerBrush}" />

        <!-- ============================================================ 行3：表格（卡片表面） -->
        <!--
          卡片的 Padding 同时作用于表头与所有行：两者拿到的是同一个内宽，
          列宽算法（Views/TableColumnLayout.AvailableWidth 在 ListView.SizeChanged 里取值）
          量到的也仍是这个内宽，因此表头与单元格的列对齐不受卡片影响。
          卡片不设 CornerRadius 以外的裁剪装饰：ListView 滚动内容由自身的 ScrollViewer 裁切，
          落在 Padding 之内，不会盖住圆角。
        -->
        <Border
            Grid.Row="3"
            Margin="{StaticResource TableCardGap}"
            Padding="{StaticResource TableCardPadding}"
            Background="{ThemeResource SurfaceBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            BorderThickness="{StaticResource CardBorderThickness}"
            CornerRadius="{StaticResource CardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 表头下方的 1px 分隔线（紧贴表头，把列标题与数据区分层） -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头：与行模板共用同一份 Columns.*Width，列宽才可能对齐 -->
                <Grid Grid.Row="0" Height="{StaticResource HeaderRowHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="{Binding Columns.NameWidth}" />
                        <ColumnDefinition Width="{Binding Columns.CurrentWidth}" />
                        <ColumnDefinition Width="{Binding Columns.TargetWidth}" />
                        <ColumnDefinition Width="{Binding Columns.StatusWidth}" />
                    </Grid.ColumnDefinitions>

                    <!-- 表头右侧统一留 12：与单元格文字的右距一致，列对齐才成立 -->
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnNameHeader}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnCurrentHeader}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnTargetHeader}" />
                    <TextBlock
                        Grid.Column="4"
                        Margin="0,0,12,0"
                        Style="{StaticResource TableHeaderTextStyle}"
                        Text="{Binding ColumnStatusHeader}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Height="1"
                    Background="{ThemeResource HeaderLineBrush}" />

                <!--
                  列表与空态上下两行：空态放 Auto 行而不是叠在列表上，
                  这样窗口压到最小高度、列表需要滚动时，提示不会压在行上。
                -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView
                        x:Name="FolderList"
                        Grid.Row="0"
                        AutomationProperties.Name="{Binding FolderListLabel}"
                        CanDragItems="False"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource FolderRowItemStyle}"
                        ItemsSource="{Binding Rows}"
                        KeyDown="OnFolderListKeyDown"
                        SelectionMode="None"
                        SizeChanged="OnFolderListSizeChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!--
                                  行底色与前景完全由 RowState 驱动，不使用 ListViewItem 的选中态：
                                  否则点击行会同时出现"高亮"和"勾选"两套状态（PRD 里只有勾选是状态）。

                                  三层结构（自下而上）：状态底色 → 悬停遮罩 → 内容。
                                  遮罩必须压在内容之下，否则会把文字一起盖住；IsHitTestVisible=False
                                  保证它不吃指针事件，滚动与勾选不受影响。悬停的切换由 RowHover 附加属性驱动
                                  （见 Controls/RowHover.cs：它挂在底色 Border 上——整个行里唯一稳定可命中的元素，
                                  文字与空白处的指针都会穿透到它；ListViewItem 自带的悬停底色被这里的不透明底色盖住，改主题画刷看不见）。

                                  注意：这一层结构不能改。RowHover 靠"父 Panel 里唯一 IsHitTestVisible=False 的 Border"
                                  认出遮罩层，在此新增任何 IsHitTestVisible=False 的 Border 都会让它找错层。
                                -->
                                <Grid>
                                    <Border
                                        controls:RowHover.OverlayName="RowHoverLayer"
                                        Background="{Binding RowState, Converter={StaticResource RowStateToBackground}}"
                                        Opacity="{Binding RowState, Converter={StaticResource RowStateToOpacity}}" />

                                    <Border
                                        x:Name="RowHoverLayer"
                                        Background="{ThemeResource RowHoverBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0" />

                                    <Grid Height="{StaticResource RowHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="{Binding Columns.NameWidth}" />
                                            <ColumnDefinition Width="{Binding Columns.CurrentWidth}" />
                                            <ColumnDefinition Width="{Binding Columns.TargetWidth}" />
                                            <ColumnDefinition Width="{Binding Columns.StatusWidth}" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                          IsEnabled 绑 CanSelect（= 阶段允许 且 这一行有东西可搬）：
                                          「路径相同」的行勾上也只会被引擎跳过，禁掉它，勾选数才等于待办数。
                                        -->
                                        <CheckBox
                                            Grid.Column="0"
                                            MinWidth="0"
                                            AutomationProperties.Name="{Binding Display}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            IsEnabled="{Binding CanSelect}" />

                                        <!-- 四列文字右侧统一留 12：列与列之间不贴脸，表头与单元格同距 -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToForeground}}"
                                            Style="{StaticResource TableNameCellTextStyle}"
                                            Text="{Binding Display}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToForeground}}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding Current}"
                                            TextTrimming="CharacterEllipsis" />

                                        <!--
                                          目标列双分支：真要搬时显示目标路径；与当前位置相同时只显示一句弱化占位，
                                          避免同一串路径在相邻两列重复出现（两列完全一样等于让眼睛白跑一趟）。
                                          占位降为 caption 字号（2026-11-14 用户反馈"再收一档"）：它是冗余信息
                                          （状态列已给出同一结论），小一号+淡灰 = 明确的"这里不用看"的注释感，
                                          不再与"当前位置"列的正文路径竞争注意力。列宽仍按完整目标路径实测，
                                          字号变化不影响布局安全。
                                        -->
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToForeground}}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding Target}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsSameAsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding SameTargetText}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsSameAsCurrent, Converter={StaticResource BoolToVisibility}}" />

                                        <!--
                                          状态列：只有文字，不画圆点（2026-11-14 用户两次反馈后定稿）。
                                          原来"圆点 + 文字"双通道的圆点在常态下连成一条灰虚线（7 行同态），
                                          是纯噪音；辨识改由文案本身承担——"无需转移/待转移/完成/失败：原因"
                                          每个字都在说状态，比颜色圆点更直接，也不依赖色觉。
                                          前景用状态列专用转换器按状态着色（处理中青/完成绿/失败红），
                                          替代圆点成为零占位的辨识通道；"无需转移/待转移"不参与着色
                                          （彩色一多就等于没有彩色）。该列不裁字：宽度由列宽算法按文字
                                          实测保护，裁字会藏掉失败原因。
                                        -->
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="0,0,12,0"
                                            Foreground="{Binding RowState, Converter={StaticResource RowStateToStatusForeground}}"
                                            Style="{StaticResource TableCellTextStyle}"
                                            Text="{Binding Status}"
                                            TextTrimming="None" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                      空态：7 项全部"路径相同"时，用提示填掉列表下方的空白，而不是留一片死白。
                      结构为"圆形徽章 + 主标题 + 弱化副文案"三级：徽章给完成态一个视觉锚点，
                      文字拆两级后主次分明，不再是一行灰字飘在空白里。
                      EmptyStateGap/Spacing 比上一版各放大一档：卡片内边距吃掉了一部分留白，
                      保持不变的话提示会显得贴着列表底部。
                    -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="{StaticResource EmptyStateGap}"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource EmptyStateSpacing}"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <Border
                            Width="{StaticResource EmptyStateBadgeSize}"
                            Height="{StaticResource EmptyStateBadgeSize}"
                            CornerRadius="{StaticResource EmptyStateBadgeCornerRadius}"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource EmptyStateBadgeBrush}">
                            <FontIcon
                                FontSize="{StaticResource EmptyStateIconSize}"
                                Foreground="{ThemeResource EmptyStateCheckBrush}"
                                Glyph="&#xE73E;" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeStrong}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{Binding EmptyStateTitle}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{ThemeResource MutedTextBrush}"
                            Text="{Binding EmptyStateSubtitle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================ 行4：操作条 -->
        <!--
          语义重排为两子行：子行0 是"选项"（只影响计划怎么算），子行1 是"命令"（真正动手的按钮）。
          RowSpacing=12 让两行的呼吸感与分隔线的 DividerGap 一致；
          Margin 用 SectionGap：命令行与表格列首的 40px 勾选列错半档，扫视更清楚。
          操作条不套卡片：它是"页面上的工具条"，不是内容表面。
        -->
        <Grid
            Grid.Row="4"
            Margin="{StaticResource SectionGap}"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 子行0：选项行（全选摘要居中撑开，创建目录靠右） -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 与行勾选框同一禁用语义：无可转移行（7 行全部路径相同）时全选框同样禁用，
                     避免出现"能点但 0 行被选"的假交互。执行期间随 IsInputEnabled 一并禁用。 -->
                <CheckBox
                    Grid.Column="0"
                    Content="{Binding SelectAllText}"
                    IsChecked="{Binding AllSelected, Mode=TwoWay}"
                    IsEnabled="{Binding CanToggleSelectAll}" />

                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding SelectionSummary}"
                    ToolTipService.ToolTip="{Binding SelectionSummary}" />

                <CheckBox
                    Grid.Column="2"
                    Content="{Binding CreateUserDirectoryText}"
                    IsChecked="{Binding CreateUserDirectory, Mode=TwoWay}"
                    IsEnabled="{Binding IsInputEnabled}" />
            </Grid>

            <!-- 子行1：命令行（退出｜撑开｜恢复默认｜主操作） -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 退出按钮用默认样式，只把圆角对齐到 ButtonCornerRadius，与另外两个按钮成一组 -->
                <Button
                    Grid.Column="0"
                    Command="{Binding ExitCommand}"
                    Content="{Binding ExitText}"
                    CornerRadius="{StaticResource ButtonCornerRadius}"
                    ToolTipService.ToolTip="{Binding ExitText}" />

                <!--
                  危险按钮：淡红填充式（DangerButtonStyle）。
                  悬停/按下加深一档在此用实例级 Resources 同名覆盖——
                  ButtonBackgroundPointerOver/Pressed 是模板里的主题画刷键而非 Button 属性，
                  样式 Setter 无法设置（WMC0090/WMC0095）；模板以 {ThemeResource} 解析，
                  实例同名覆盖即生效，主题切换跟随 ThemeDictionaries，零模板自绘。
                -->
                <Button
                    Grid.Column="2"
                    Margin="{StaticResource DangerGap}"
                    Command="{Binding RestoreDefaultsCommand}"
                    Content="{Binding RestoreDefaultsText}"
                    Style="{StaticResource DangerButtonStyle}"
                    ToolTipService.ToolTip="{Binding RestoreDefaultsText}">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerButtonHoverBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerButtonPressedBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerButtonHoverBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerButtonPressedBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>

                <!--
                  主操作：全屏唯一强调按钮；AcceleratorKey 供读屏播报快捷键。
                  背景/前景五态在此用实例级 Resources 同名覆盖
                  （机制与上方危险按钮相同：ButtonBackground*/ButtonForeground* 是模板里的
                  主题画刷键而非 Button 属性，样式 Setter 写不得——WMC0090/WMC0095；
                  模板以 {ThemeResource} 解析，实例同名覆盖即生效，零模板自绘）。
                  取值指向 Tokens 的强调四档（AccentFillColorSecondary/Tertiary/Disabled）；
                  正常态的青碧底与白字由 Styles.xaml 的 PrimaryActionButtonStyle
                  显式引用 AccentBrush / OnAccentTextBrush 提供（AccentButtonStyle 的
                  Background 解析封闭在 XamlControlsResources 内，App 级覆盖不可达，故弃用）。
                  悬停/按下必须同时覆盖前景键：Button 模板的 PointerOver/Pressed 态会把
                  Foreground 换成 ButtonForegroundPointerOver/Pressed（Fluent 深灰），
                  深字压在青碧底上对比度不足（2.81:1），白字为 4.42:1。
                -->
                <Button
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    AutomationProperties.AcceleratorKey="Ctrl+Enter"
                    Command="{Binding PrimaryCommand}"
                    Content="{Binding PrimaryButtonText}"
                    IsEnabled="{Binding IsPrimaryEnabled}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    ToolTipService.ToolTip="{Binding PrimaryButtonText}">
                    <Button.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentTextBrush" />
                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentTextBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="OnAccentTextBrush" />
                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="OnAccentTextBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>

        <!-- ============================================================ 行5：分隔线 -->
        <Border
            Grid.Row="5"
            Margin="{StaticResource DividerGap}"
            Background="{ThemeResource DividerBrush}" />

        <!-- ============================================================ 行6：状态栏 -->
        <Grid Grid.Row="6" Margin="{StaticResource StackGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- LiveSetting=Polite：状态文本变化时读屏主动播报，不打断当前朗读 -->
            <TextBlock
                Grid.Column="0"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource StatusTextStyle}"
                Text="{Binding StatusText}" />

            <HyperlinkButton
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding OpenLogCommand}"
                Content="{Binding OpenLogText}"
                Style="{StaticResource LinkButtonStyle}"
                ToolTipService.ToolTip="{Binding OpenLogText}"
                Visibility="{Binding IsLogLinkVisible, Converter={StaticResource BoolToVisibility}}" />

            <!--
              进度条只在迁移进行中显示（IsBusy）：空闲时 Value=0 只剩一条细轨道线，
              悬在状态栏右端像一根无意义的横线（用户反馈），故空闲时整体折叠。
              IsBusy 在 VM 里带变更通知，迁移开始/结束自动切换。
            -->
            <ProgressBar
                Grid.Column="2"
                Margin="12,0,0,0"
                Maximum="100"
                Minimum="0"
                VerticalAlignment="Center"
                Value="{Binding ProgressValue, Mode=OneWay}"
                Width="{StaticResource ProgressWidth}"
                MinHeight="{StaticResource ProgressBarMinHeight}"
                Foreground="{ThemeResource AccentTextBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- 试运行徽标：淡黄胶囊底（WarningSubtle）+ 深黄字，Visibility 绑定移到外层 Border -->
            <Border
                Grid.Column="3"
                Margin="12,0,0,0"
                Padding="8,2"
                Background="{ThemeResource WarningSubtleBrush}"
                CornerRadius="10"
                Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource WarningTextBrush}"
                    Style="{StaticResource StatusTextStyle}"
                    Text="{Binding DryRunBadge}" />
            </Border>
        </Grid>
    </Grid>
</Window>
