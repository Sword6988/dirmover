<?xml version="1.0" encoding="utf-8"?>
<!--
  Styles.xaml —— 控件外观聚合点。

  分层规则（对应 PRD §9.3 的"主/次/危险"三级）：
    * 主操作：PrimaryActionButtonStyle —— 基于 AccentButtonStyle 只调 Padding，
      全屏唯一强调按钮（故此处**不**重定义强调视觉，只放吸气垫）；
    * 危险操作：DangerButtonStyle —— 淡红填充式，底色/前景取 Danger 令牌，
      不抢主按钮的强调色，又能在扫视时被识别为"不可逆动作"；
    * 链接操作：LinkButtonStyle —— 用于状态栏的"打开日志目录"这类轻动作。

  本文件不出现任何颜色字面量与裸像素：全部引用 Tokens.xaml 的令牌。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      危险操作按钮（恢复系统默认值）：淡红填充式。
      底色用 DangerSubtleBrush（红只在"这一颗按钮"上出现，且比描边式更早被扫视到），
      border 归零避免描边抢色。
      悬停/按下加深一档（DangerButtonHover/Pressed 令牌）不在本样式里落 Setter：
      ButtonBackgroundPointerOver/Pressed 是模板里的主题画刷键而非 Button 属性，
      且 FrameworkElement.Resources 也不是依赖属性，两种 Setter 写法都会被
      XAML 编译器拒绝（WMC0090 / WMC0095）。合规落点是 MainWindow 里该按钮的
      实例级 Resources 同名覆盖（模板以 {ThemeResource} 解析这两个键，覆盖即生效，
      零模板自绘、主题切换照常跟随）。
    -->
    <Style
        x:Key="DangerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource DangerSubtleBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DangerTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- 轻量链接按钮（打开日志目录 / 以管理员身份重启） -->
    <Style
        x:Key="LinkButtonStyle"
        BasedOn="{StaticResource DefaultHyperlinkButtonStyle}"
        TargetType="HyperlinkButton">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!--
      主操作按钮：全屏唯一强调按钮。
      直接基于 AccentButtonStyle（强调视觉由 App.xaml 的主题画刷重定向统一控制），
      这里只放 Padding 吸气垫：主按钮是唯一终点，视觉分量应当最重。
    -->
    <Style
        x:Key="PrimaryActionButtonStyle"
        BasedOn="{StaticResource AccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <!-- 表头文字（唯一一处允许出现"列标题"的位置，文案由 UiText 注入） -->
    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="None" />
        <!-- 字间距 50（1/1000 em）：小字号大写式表头的可读性补偿 -->
        <Setter Property="CharacterSpacing" Value="50" />
    </Style>

    <!-- 表格单元文字（状态列不允许裁字，故 TextTrimming 由行模板按列分别设置） -->
    <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      名称列专用：比正文大一档并加半粗。
      七行里只有名称是"扫读锚点"，路径是细节；两者同字重时眼睛没有落点，
      整屏看起来像一堵文字墙。前景仍由行模板按 RowState 逐列覆盖。
    -->
    <Style x:Key="TableNameCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableCellTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 状态栏文字（muted，可用宽度不足时尾部省略） -->
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
      表格行容器：行高固定 40、内容拉伸、去掉列表自身的选中/悬停视觉。
      为什么要覆盖：ListView 默认"点击行设置 SelectedItem"，会与行首 CheckBox
      形成双状态（PRD 语义里勾选才是唯一状态）。勾选态与着色完全由 RowState 驱动，
      因此行容器只保留结构，不承担任何状态表达。悬停/按下的画刷覆盖在 T14 补齐
      （需要重写 ListViewItemPresenter 模板，属 T14 的核对清单第 ⑤ 项）。
    -->
    <Style x:Key="FolderRowItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource RowHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

</ResourceDictionary>
