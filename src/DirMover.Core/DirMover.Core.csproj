<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DirMover.Core —— 引擎层：静态真源、注册表、文件系统、编排、文案、列宽算法。

    设计要点（为什么这么写）：
    1. 本机没有 Visual Studio 的 AppxPackage/PriGen MSBuild 任务，App 项目**无法编译**。
       因此一切"可判定逻辑"必须落在这里，让 `dotnet build` / `dotnet test` 真正验证它。
    2. 零 PackageReference：Core 只用 BCL + P/Invoke。多一个包就多一处"本机还原不了"
       的失败面，也让红线守卫（grep PackageReference）失效。
    3. 零 UI 引用：不出现 Microsoft.UI.* / Windows.*。Core 一旦引用 UI 类型，
       单测就只能跑在有 UI 线程的宿主里，安全逻辑再也无法脱离界面被验证。

    InternalsVisibleTo 给测试工程：Catalog.SystemDrive 需要 internal setter 才能模拟
    "系统盘不是 C:"（审计 A4：写死 C: 会让整道禁区闸门在改过盘符的机器上 fail-open）。
  -->
  <PropertyGroup>
    <!--
      多目标：net8.0-windows 给 WinUI 版，net48 给 WPF 单文件版。
      两套界面共用同一份引擎代码，红线守卫与单测都只针对 net8 跑，
      net48 分支仅要求"同样的输入给同样的结果"，不做第二次逻辑复制。
    -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>DirMover.Core</RootNamespace>
    <AssemblyName>DirMover.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    net48 没有 System.Text.Json（它随 .NET Core 3.0 才进 BCL）。这里只给 net48 补包，
    net8 目标保持零 PackageReference——红线守卫脚本按 net8 的依赖面判定。
    选 8.0.x 是因为它是最后一个仍然支持 net462+ 的主线版本。
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>


  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DirMover.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
